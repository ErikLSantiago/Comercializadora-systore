<odoo>
    <record id="rule_account_financial_group_company" model="ir.rule">
        <field name="name">Financial groups: company</field>
        <field name="model_id" ref="model_account_financial_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="rule_account_financial_group_rule_company" model="ir.rule">
        <field name="name">Financial group rules: company</field>
        <field name="model_id" ref="model_account_financial_group_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
