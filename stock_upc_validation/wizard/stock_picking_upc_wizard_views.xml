<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_upc_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.upc.wizard.form</field>
        <field name="model">stock.picking.upc.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar UPC/EAN de recolección">
                <sheet>
                    <group>
                        <field name="picking_id"/>
                        <field name="picking_type_id"/>
                        <field name="require_tracking_on_pack" invisible="1"/>
                        <field name="tracking_ref" string="Número de guía" placeholder="Escanee o capture la guía" invisible="not require_tracking_on_pack"/>
                    </group>
                    <p class="text-muted">
                        Escanee el UPC/EAN del producto físico y capture el NS/IMEI. El sistema solo permitirá avanzar si el UPC/EAN pertenece al producto esperado y guardará el NS/IMEI en el registro alterno de números de serie.
                    </p>
                    <field name="line_ids" mode="list">
                        <list editable="bottom" create="0" delete="0">
                            <field name="scan_no" string="#"/>
                            <field name="product_id"/>
                            <field name="upc_ean" placeholder="Escanee UPC/EAN"/>
                            <field name="serial_imei" string="NS/IMEI" placeholder="Escanee o capture NS/IMEI"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar y validar traslado" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
