<odoo>
    <record id="view_account_financial_group_tree" model="ir.ui.view">
        <field name="name">account.financial.group.tree</field>
        <field name="model">account.financial.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="scope"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_account_financial_group_form" model="ir.ui.view">
        <field name="name">account.financial.group.form</field>
        <field name="model">account.financial.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="scope"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_financial_group" model="ir.actions.act_window">
        <field name="name">Grupos financieros</field>
        <field name="res_model">account.financial.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_financial_group"
              name="Grupos financieros"
              parent="account.menu_finance_configuration"
              action="action_account_financial_group"
              sequence="90"/>
</odoo>
