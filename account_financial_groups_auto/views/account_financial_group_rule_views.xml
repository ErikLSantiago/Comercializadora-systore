<odoo>
    <record id="view_account_financial_group_rule_tree" model="ir.ui.view">
        <field name="name">account.financial.group.rule.tree</field>
        <field name="model">account.financial.group.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="group_id"/>
                <field name="rule_type"/>
                <field name="code_prefix" optional="hide"/>
                <field name="code_regex" optional="hide"/>
                <field name="name_contains" optional="hide"/>
                <field name="account_type" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_account_financial_group_rule_form" model="ir.ui.view">
        <field name="name">account.financial.group.rule.form</field>
        <field name="model">account.financial.group.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="group_id"/>
                        <field name="rule_type"/>
                        <field name="stop_at_first_match"/>
                    </group>

                    <group invisible="rule_type != 'code_prefix'">
                        <field name="code_prefix"/>
                    </group>
                    <group invisible="rule_type != 'code_regex'">
                        <field name="code_regex"/>
                    </group>
                    <group invisible="rule_type != 'name_contains'">
                        <field name="name_contains"/>
                    </group>
                    <group invisible="rule_type != 'account_type'">
                        <field name="account_type"/>
                    </group>
                    <group invisible="rule_type != 'domain'">
                        <field name="domain" placeholder="[('account_type','=','expense'),('code','=like','61%')]"/>
                    </group>
                    <separator string="Tip"/>
                    <p>
                        Define reglas simples (prefijo, regex, contiene) para evitar errores operativos.
                        Ordena por secuencia: la primera coincidencia asigna el grupo.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_financial_group_rule" model="ir.actions.act_window">
        <field name="name">Reglas de grupos financieros</field>
        <field name="res_model">account.financial.group.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_account_financial_group_rule"
              name="Reglas de asignación"
              parent="menu_account_financial_group"
              action="action_account_financial_group_rule"
              sequence="10"/>
</odoo>
