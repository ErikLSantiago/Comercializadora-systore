<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_mkp_collection" model="ir.ui.view">
        <field name="name">sale.order.form.mkp.collection.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_mkp_collection" type="object" class="oe_stat_button"
                        icon="fa-money" groups="mkp_collection_control.group_mkp_collection_operator">
                    <field name="mkp_collection_event_count" widget="statinfo" string="Cobranza"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
