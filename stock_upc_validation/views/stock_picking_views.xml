<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_tracking_ref_pack" model="ir.ui.view">
        <field name="name">stock.picking.form.tracking.ref.pack</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="systore_require_tracking_on_pack" invisible="1"/>
                <field name="systore_batch_readiness_state" widget="badge" decoration-danger="systore_batch_readiness_state == 'partial'" decoration-success="systore_batch_readiness_state == 'complete'"/>
                <field name="carrier_tracking_ref" string="Número de guía" placeholder="Escanee o capture la guía"
                       invisible="not systore_require_tracking_on_pack"
                       readonly="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>


    <record id="view_picking_tree_batch_readiness_state" model="ir.ui.view">
        <field name="name">stock.picking.list.batch.readiness.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="systore_batch_readiness_state" string="Estado para lote" widget="badge" optional="show"
                       decoration-danger="systore_batch_readiness_state == 'partial'"
                       decoration-success="systore_batch_readiness_state == 'complete'"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_search_batch_readiness_state" model="ir.ui.view">
        <field name="name">stock.picking.search.batch.readiness.state</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Completas para lote" name="systore_batch_complete" domain="[('systore_batch_readiness_state','=','complete')]"/>
                <filter string="Parciales para lote" name="systore_batch_partial" domain="[('systore_batch_readiness_state','=','partial')]"/>
            </xpath>
        </field>
    </record>

</odoo>
