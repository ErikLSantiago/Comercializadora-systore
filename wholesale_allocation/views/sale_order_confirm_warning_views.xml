<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_confirm_warning_form" model="ir.ui.view">
        <field name="name">sale.order.confirm.warning.form</field>
        <field name="model">sale.order.confirm.warning</field>
        <field name="arch" type="xml">
            <form string="Confirmar sin Orden de Compra asociada">
                <sheet>
                    <group>
                        <field name="sale_order_id" invisible="1"/>
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_continue_confirm" type="object" string="Sí, continuar" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
