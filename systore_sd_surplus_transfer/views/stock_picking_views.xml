<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_sd_surplus_transfer" model="ir.ui.view">
        <field name="name">stock.picking.form.surplus.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_surplus_transfers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="surplus_transfer_count == 0">
                    <field name="surplus_transfer_count" widget="statinfo" string="Surplus"/>
                </button>
                <button name="action_view_surplus_source_receipt"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="not surplus_source_receipt_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Operación origen</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_surplus_auto_transfer" invisible="1"/>
                <field name="surplus_transfer_processed" invisible="1"/>
                <field name="surplus_source_receipt_id"
                       readonly="1"
                       invisible="not surplus_source_receipt_id"/>
                <field name="surplus_rule_id"
                       readonly="1"
                       invisible="not surplus_rule_id"/>
            </xpath>
        </field>
    </record>
</odoo>
