<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_wholesale_allocation" model="ir.ui.view">
        <field name="name">stock.picking.form.wholesale.allocation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Wholesale Allocation" invisible="not is_wholesale_allocation">
                    <field name="is_wholesale_allocation" invisible="1"/>
                    <field name="associated_purchase_order_ids" widget="many2many_tags" readonly="1"/>
                    <field name="allowed_lot_names_display" readonly="1"/>
                    <div class="text-muted">
                        <span>Automatic reservation is limited to the lots that match the associated purchase orders. Users can still assign other lots manually when needed.</span>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
