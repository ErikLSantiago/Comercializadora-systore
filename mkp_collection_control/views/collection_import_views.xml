<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_collection_import_wizard_form" model="ir.ui.view">
        <field name="name">mkp.collection.import.wizard.form</field>
        <field name="model">mkp.collection.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar registros de cobranza">
                <sheet>
                    <group>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <p>Use un CSV UTF-8 separado por coma, punto y coma o tabulador.</p>
                        <p>Encabezados: pedido_odoo, estado, fecha_evento, venta, cupon, killer,
                           retenciones, comision, comision_killer, comision_cupon, envio,
                           otras_comisiones, importe_devolucion, origen_devolucion,
                           referencia, comentario.</p>
                        <p>Borrador, Confirmado y Recalculado requieren Venta y representan una
                           fotografía completa. Para Devolución use importe_devolucion y
                           origen_devolucion.</p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Importar registros"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_collection_import" model="ir.actions.act_window">
        <field name="name">Importar registros de cobranza</field>
        <field name="res_model">mkp.collection.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_collection_import_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
