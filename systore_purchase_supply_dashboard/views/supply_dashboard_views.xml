<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supply_purchase_line_list" model="ir.ui.view">
        <field name="name">systore.supply.purchase.line.list</field>
        <field name="model">systore.supply.purchase.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="pending_qty &gt; 0" decoration-success="pending_qty == 0">
                <field name="report_date"/>
                <field name="first_receipt_date" optional="show"/>
                <field name="purchase_order_id"/>
                <field name="supplier_id"/>
                <field name="warehouse_id"/>
                <field name="channel" widget="badge"/>
                <field name="product_id"/>
                <field name="sku"/>
                <field name="purchase_origin" widget="badge"/>
                <field name="ordered_qty" sum="Ordenadas"/>
                <field name="received_qty" sum="Recibidas"/>
                <field name="pending_qty" sum="Pendientes"/>
                <field name="reception_percent" optional="show"/>
                <field name="landed_cost_mxn_unit" optional="show"/>
                <field name="received_value_mxn" sum="Valor recibido" optional="show"/>
                <field name="pending_value_mxn" sum="Valor pendiente" optional="show"/>
                <field name="payment_status" widget="badge" optional="show"
                       decoration-danger="payment_status == 'pending'"
                       decoration-warning="payment_status == 'partial'"
                       decoration-success="payment_status == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_supply_purchase_line_pivot" model="ir.ui.view">
        <field name="name">systore.supply.purchase.line.pivot</field>
        <field name="model">systore.supply.purchase.line</field>
        <field name="arch" type="xml">
            <pivot string="Recepciones de compra">
                <field name="report_date" type="row" interval="month"/>
                <field name="supplier_id" type="row"/>
                <field name="channel" type="col"/>
                <field name="ordered_qty" type="measure"/>
                <field name="received_qty" type="measure"/>
                <field name="pending_qty" type="measure"/>
                <field name="received_value_mxn" type="measure"/>
                <field name="pending_value_mxn" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_supply_purchase_line_graph" model="ir.ui.view">
        <field name="name">systore.supply.purchase.line.graph</field>
        <field name="model">systore.supply.purchase.line</field>
        <field name="arch" type="xml">
            <graph string="Ordenado vs recibido" type="bar" stacked="1">
                <field name="report_date" interval="month"/>
                <field name="received_qty" type="measure"/>
                <field name="pending_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_supply_purchase_line_search" model="ir.ui.view">
        <field name="name">systore.supply.purchase.line.search</field>
        <field name="model">systore.supply.purchase.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="purchase_order_name"/>
                <field name="sku"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="warehouse_id"/>
                <filter name="pending_receipt" string="Pendientes de recibir" domain="[('pending_qty', '&gt;', 0)]"/>
                <filter name="without_receipt" string="Sin recepción" domain="[('has_receipt', '=', False)]"/>
                <filter name="international" string="Internacionales" domain="[('purchase_origin', '=', 'international')]"/>
                <separator/>
                <filter name="group_month" string="Mes de reporte" context="{'group_by': 'report_date:month'}"/>
                <filter name="group_supplier" string="Proveedor" context="{'group_by': 'supplier_id'}"/>
                <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_payment" string="Estado de pago" context="{'group_by': 'payment_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_supply_purchase_lines" model="ir.actions.act_window">
        <field name="name">Recepciones de compra</field>
        <field name="res_model">systore.supply.purchase.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_supply_purchase_line_search"/>
    </record>

    <record id="view_supply_demand_line_list" model="ir.ui.view">
        <field name="name">systore.supply.demand.line.list</field>
        <field name="model">systore.supply.demand.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="coverage_status == 'shortage'" decoration-warning="coverage_status == 'incoming'">
                <field name="period_month"/>
                <field name="warehouse_id"/>
                <field name="channel" widget="badge"/>
                <field name="product_id"/>
                <field name="sku"/>
                <field name="sales_order_count" sum="Ventas"/>
                <field name="linked_wholesale_sale_count" sum="Mayoreo con OC" optional="hide"/>
                <field name="unlinked_wholesale_sale_count" sum="Mayoreo sin OC" optional="hide"/>
                <field name="complete_picking_count" sum="Traslados completos" optional="hide"/>
                <field name="partial_picking_count" sum="Traslados parciales" optional="show"/>
                <field name="open_demand_qty" sum="Demanda"/>
                <field name="on_hand_qty" sum="Existencia"/>
                <field name="reserved_qty" sum="Reservada" optional="show"/>
                <field name="free_qty" sum="Libre" optional="hide"/>
                <field name="incoming_qty" sum="Por recibir"/>
                <field name="covered_by_stock_qty" sum="Cubierta inventario" optional="hide"/>
                <field name="covered_by_incoming_qty" sum="Cubierta compras" optional="hide"/>
                <field name="missing_to_buy_qty" sum="Falta comprar"/>
                <field name="coverage_status" widget="badge"
                       decoration-danger="coverage_status == 'shortage'"
                       decoration-warning="coverage_status == 'incoming'"
                       decoration-success="coverage_status in ('stock', 'no_demand')"/>
                <field name="snapshot_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_supply_demand_line_pivot" model="ir.ui.view">
        <field name="name">systore.supply.demand.line.pivot</field>
        <field name="model">systore.supply.demand.line</field>
        <field name="arch" type="xml">
            <pivot string="Demanda de abastecimiento">
                <field name="period_month" type="row" interval="month"/>
                <field name="warehouse_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="channel" type="col"/>
                <field name="open_demand_qty" type="measure"/>
                <field name="on_hand_qty" type="measure"/>
                <field name="incoming_qty" type="measure"/>
                <field name="missing_to_buy_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_supply_demand_line_graph" model="ir.ui.view">
        <field name="name">systore.supply.demand.line.graph</field>
        <field name="model">systore.supply.demand.line</field>
        <field name="arch" type="xml">
            <graph string="Demanda y cobertura" type="bar" stacked="1">
                <field name="warehouse_id"/>
                <field name="period_month"/>
                <field name="on_hand_qty" type="measure"/>
                <field name="incoming_qty" type="measure"/>
                <field name="missing_to_buy_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_supply_demand_line_search" model="ir.ui.view">
        <field name="name">systore.supply.demand.line.search</field>
        <field name="model">systore.supply.demand.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="sku"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <filter name="shortage" string="Falta comprar" domain="[('missing_to_buy_qty', '&gt;', 0)]"/>
                <filter name="incoming" string="Cubierta con compras" domain="[('coverage_status', '=', 'incoming')]"/>
                <separator/>
                <filter name="group_warehouse" string="Almacén" context="{'group_by': 'warehouse_id'}"/>
                <filter name="group_month" string="Mes" context="{'group_by': 'period_month:month'}"/>
                <filter name="group_channel" string="Canal" context="{'group_by': 'channel'}"/>
                <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                <filter name="group_coverage" string="Cobertura" context="{'group_by': 'coverage_status'}"/>
            </search>
        </field>
    </record>

    <record id="action_supply_demand_lines" model="ir.actions.act_window">
        <field name="name">Demanda y faltantes</field>
        <field name="res_model">systore.supply.demand.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_supply_demand_line_search"/>
    </record>

    <record id="view_supply_trace_line_list" model="ir.ui.view">
        <field name="name">systore.supply.trace.line.list</field>
        <field name="model">systore.supply.trace.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="movement_date"/>
                <field name="lot_id"/>
                <field name="purchase_order_id"/>
                <field name="sale_order_id"/>
                <field name="supplier_id"/>
                <field name="warehouse_id"/>
                <field name="channel" widget="badge"/>
                <field name="product_id"/>
                <field name="sku"/>
                <field name="quantity" sum="Piezas"/>
                <field name="unit_cost_mxn" optional="show"/>
                <field name="total_cost_mxn" sum="Costo total" optional="show"/>
                <field name="picking_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_supply_trace_line_pivot" model="ir.ui.view">
        <field name="name">systore.supply.trace.line.pivot</field>
        <field name="model">systore.supply.trace.line</field>
        <field name="arch" type="xml">
            <pivot string="Trazabilidad por lote">
                <field name="purchase_order_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="channel" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="total_cost_mxn" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_supply_trace_line_search" model="ir.ui.view">
        <field name="name">systore.supply.trace.line.search</field>
        <field name="model">systore.supply.trace.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id"/>
                <field name="purchase_order_id"/>
                <field name="sale_order_id"/>
                <field name="sku"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <filter name="group_po" string="Orden de compra" context="{'group_by': 'purchase_order_id'}"/>
                <filter name="group_sale" string="Orden de venta" context="{'group_by': 'sale_order_id'}"/>
                <filter name="group_supplier" string="Proveedor" context="{'group_by': 'supplier_id'}"/>
                <filter name="group_channel" string="Canal" context="{'group_by': 'channel'}"/>
            </search>
        </field>
    </record>

    <record id="action_supply_trace_lines" model="ir.actions.act_window">
        <field name="name">Trazabilidad por lote</field>
        <field name="res_model">systore.supply.trace.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_supply_trace_line_search"/>
    </record>

    <record id="view_purchase_payment_list" model="ir.ui.view">
        <field name="name">systore.purchase.payment.list</field>
        <field name="model">systore.purchase.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="payment_date"/>
                <field name="purchase_order_id"/>
                <field name="partner_id"/>
                <field name="concept"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_mxn" sum="Total"/>
                <field name="reference"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_payment_form" model="ir.ui.view">
        <field name="name">systore.purchase.payment.form</field>
        <field name="model">systore.purchase.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="purchase_order_id"/>
                        <field name="payment_date"/>
                        <field name="partner_id"/>
                        <field name="concept"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_mxn"/>
                        <field name="reference"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_payments" model="ir.actions.act_window">
        <field name="name">Pagos manuales</field>
        <field name="res_model">systore.purchase.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
