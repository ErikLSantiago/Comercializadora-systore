<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_contact_privacy_list" model="ir.ui.view">
        <field name="name">res.partner.contact.privacy.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Asignación de contactos" editable="bottom" create="false" delete="false">
                <field name="display_name" readonly="1"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="user_id" string="Vendedor responsable"/>
                <field name="contact_allowed_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="action_contact_privacy_assignment" model="ir.actions.act_window">
        <field name="name">Privacidad de contactos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_partner_contact_privacy_list"/>
        <field name="context">{'search_default_customer': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Asigne vendedores o usuarios autorizados a los contactos.</p>
        </field>
    </record>

    <menuitem id="menu_contact_privacy_assignment"
              name="Privacidad de contactos"
              parent="contacts.menu_contacts"
              action="action_contact_privacy_assignment"
              sequence="90"
              groups="contact_salesperson_privacy.group_contact_privacy_all"/>
</odoo>
