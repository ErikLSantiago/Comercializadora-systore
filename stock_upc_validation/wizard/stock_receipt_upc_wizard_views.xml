<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_receipt_upc_wizard_form" model="ir.ui.view">
        <field name="name">stock.receipt.upc.wizard.form</field>
        <field name="model">stock.receipt.upc.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar UPC/EAN de recepción">
                <sheet>
                    <group>
                        <field name="picking_id"/>
                        <field name="origin" string="Documento origen / lote automático"/>
                    </group>
                    <p class="text-muted">
                        Capture o escanee el UPC/EAN correspondiente a cada producto recibido. Al confirmar, el código se validará contra los UPC múltiples y el documento origen se asignará como lote.
                    </p>
                    <field name="line_ids" mode="list">
                        <list editable="bottom" create="0" delete="0">
                            <field name="product_id"/>
                            <field name="upc_ean" placeholder="Escanee UPC/EAN"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar y validar recepción" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
