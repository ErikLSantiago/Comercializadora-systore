<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_receipt_upc_wizard_form" model="ir.ui.view">
        <field name="name">stock.receipt.upc.wizard.form</field>
        <field name="model">stock.receipt.upc.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar UPC/EAN de recepción">
                <sheet>
                    <group>
                        <field name="picking_id"/>
                        <field name="origin" string="Documento origen / lote automático"/>
                    </group>
                    <p class="text-muted">
                        Capture la cantidad recibida y escanee el UPC/EAN correspondiente a cada producto. Si la recepción llega parcial, ajuste la columna Cantidad o elimine líneas que no se procesarán; Odoo conservará su flujo nativo de backorder cuando aplique.
                    </p>
                    <field name="line_ids" mode="list">
                        <list editable="bottom" create="0" delete="1">
                            <field name="product_id"/>
                            <field name="demand_qty" string="Demanda"/>
                            <field name="quantity" string="Cantidad"/>
                            <field name="upc_ean" placeholder="Escanee UPC/EAN" readonly="skip_upc_validation"/>
                            <field name="skip_upc_validation" string="El producto no cuenta con UPC/EAN"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar y validar recepción" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
