<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_type_form_upc_validation" model="ir.ui.view">
        <field name="name">stock.picking.type.form.upc.validation</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Validaciones Systore">
                    <field name="systore_require_upc_on_receipt"/>
                    <field name="systore_auto_lot_from_origin" invisible="not systore_require_upc_on_receipt"/>
                    <field name="systore_require_upc_on_picking"/>
                    <field name="systore_upc_validation_per_product" invisible="not systore_require_upc_on_picking"/>
                    <field name="systore_require_tracking_on_pack"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
