<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_pack_tracking_wizard_form" model="ir.ui.view">
        <field name="name">stock.pack.tracking.wizard.form</field>
        <field name="model">stock.pack.tracking.wizard</field>
        <field name="arch" type="xml">
            <form string="Capturar número de guía">
                <group>
                    <field name="picking_id"/>
                    <field name="tracking_ref" placeholder="Escanee o capture la guía"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar y validar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
