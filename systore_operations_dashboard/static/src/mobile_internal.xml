<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="systore_operations_dashboard.MobileInternal">
<div class="smp-shell">
<header class="smp-header"><button class="smp-icon-button" t-on-click="back" t-att-disabled="state.busy" aria-label="Volver"><i class="fa fa-arrow-left"/></button><div><small t-esc="state.panel?.warehouse || ''"/><h1 t-esc="state.detail?.name || title"/></div><button class="smp-icon-button" t-if="state.page === 'panel'" t-on-click="() => this.loadPanel()" t-att-disabled="state.busy" aria-label="Actualizar"><i class="fa fa-refresh"/></button></header>
<main class="smp-main">
<div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/><div t-if="state.message" class="alert alert-success" t-esc="state.message"/>
<p t-if="state.busy" role="status">Procesando…</p>
<t t-if="state.page === 'panel'">
<label class="smp-search"><span class="visually-hidden">Buscar</span><input type="search" t-model="state.query" t-on-keydown="searchKey" placeholder="Buscar operación, origen, producto o UPC"/><button class="smp-link" t-on-click="search" t-att-disabled="state.busy">Buscar</button></label>
<div class="smp-grid"><button t-foreach="cards" t-as="card" t-key="card.key" class="smp-card smp-operation" t-on-click="() => this.openCard(card)" t-att-disabled="state.busy"><span class="smp-badge smp-ready">Listo</span><h2 t-esc="card.name"/><p t-esc="card.origins.join(', ')"/><p t-esc="card.operation_type"/><div class="smp-quantity"><span>Piezas</span><strong t-esc="format(card.pieces)"/></div></button></div>
<p t-if="state.panel &amp;&amp; !cards.length">No hay operaciones listas para este filtro.</p>
<nav class="smp-pagination" t-if="state.panel"><button t-on-click="() => this.loadPanel(state.pageNumber - 1)" t-att-disabled="state.busy || !state.pageNumber">Anterior</button><span>Página <t t-esc="state.pageNumber + 1"/></span><button t-on-click="() => this.loadPanel(state.pageNumber + 1)" t-att-disabled="state.busy || !state.panel.has_more">Siguiente</button></nav>
</t>
<t t-if="state.page === 'detail' &amp;&amp; state.detail">
<div class="smp-detail-heading"><h2 t-esc="state.detail.origin"/><button class="smp-link" t-on-click="original" t-att-disabled="state.busy">Abrir original</button></div>
<div class="smp-grid"><article t-foreach="state.detail.rows" t-as="row" t-key="row.id" class="smp-card smp-product"><div class="smp-location"><i class="fa fa-map-marker"/><div><span class="smp-label">Origen → Destino</span><strong><t t-esc="row.source"/> → <t t-esc="row.destination"/></strong></div></div><div class="smp-product-heading"><div class="smp-product-image"><i class="fa fa-cube"/><img t-att-src="imageURL(row.product_id)" t-att-alt="row.product" width="96" height="96" t-on-error="imageError"/></div><h3 t-esc="row.product"/></div><div class="smp-quantity"><span>Solicitadas</span><strong t-esc="format(row.qty)"/><span t-esc="row.uom"/></div><label class="smp-field">Cantidad a transferir<input type="number" min="0" t-att-max="row.qty" step="any" t-model.number="row.quantity" t-att-disabled="state.busy"/></label></article></div>
</t>
<div t-if="state.page === 'pending'" class="smp-empty">Complete el asistente de Odoo.<button class="smp-link" t-on-click="() => this.loadPanel()">Volver al panel</button></div>
</main>
<footer class="smp-footer" t-if="state.page === 'detail'"><button class="smp-primary" t-on-click="validate" t-att-disabled="state.busy || !state.detail.rows.length">Validar transferencia <i class="fa fa-check"/></button></footer>
</div></t></templates>
