<odoo>
  <record id="view_prepayment_apply_wizard_form" model="ir.ui.view">
    <field name="name">account.prepayment.apply.wizard.form</field>
    <field name="model">account.prepayment.apply.wizard</field>
    <field name="arch" type="xml">
      <form string="Pagar con anticipo">
        <group>
          <field name="move_id" readonly="1"/>
          <field name="date"/>
          <field name="journal_id" options="{'no_create': False}"/>
          <field name="prepayment_account_id" options="{'no_create': False}"/>
          <field name="amount"/>
          <field name="memo"/>
        </group>
        <footer>
          <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
