<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="external_layout_wave_mkp_wholesale_company_name"
              inherit_id="web.external_layout_wave">
        <xpath expr="//div[@name='company_address']/ul[@name='company_address_list']"
               position="before">
            <div t-if="o and o.env.context.get('mkp_wholesale_statement_header')"
                 class="fw-bold mb-1">
                Comercializadora Systore S. A. de C. V.
            </div>
        </xpath>
    </template>

    <template id="external_layout_folder_mkp_wholesale_company_name"
              inherit_id="web.external_layout_folder">
        <xpath expr="//div[@name='company_address']/ul[@name='company_address_list']"
               position="before">
            <div t-if="o and o.env.context.get('mkp_wholesale_statement_header')"
                 class="fw-bold mb-1">
                Comercializadora Systore S. A. de C. V.
            </div>
        </xpath>
    </template>

    <template id="report_wholesale_statement">
        <t t-call="web.html_container">
            <t t-foreach="customer_groups" t-as="group">
                <t t-set="o"
                   t-value="group['orders'][0].with_context(mkp_wholesale_statement_header=True)"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .mkp-wholesale-statement-table {
                                width: 100%;
                                border: 0 !important;
                                border-collapse: separate;
                                border-spacing: 0 3px;
                                table-layout: fixed;
                                font-size: 9px;
                                -webkit-print-color-adjust: exact;
                            }
                            .mkp-wholesale-statement-table,
                            .mkp-wholesale-statement-table thead,
                            .mkp-wholesale-statement-table tbody,
                            .mkp-wholesale-statement-table tfoot,
                            .mkp-wholesale-statement-table tr,
                            .mkp-wholesale-statement-table th,
                            .mkp-wholesale-statement-table td {
                                border: 0 !important;
                                outline: 0 !important;
                                box-shadow: none !important;
                            }
                            .mkp-wholesale-statement-table thead th {
                                padding: 7px 4px;
                                background: #17384d !important;
                                color: #ffffff !important;
                                font-size: 8px;
                                font-weight: 700 !important;
                                letter-spacing: 0.2px;
                                text-transform: uppercase;
                                white-space: normal;
                            }
                            .mkp-wholesale-statement-table thead th:first-child {
                                border-radius: 5px 0 0 5px;
                            }
                            .mkp-wholesale-statement-table thead th:last-child {
                                border-radius: 0 5px 5px 0;
                            }
                            .mkp-wholesale-statement-table tbody td,
                            .mkp-wholesale-statement-table tfoot td {
                                padding: 7px 4px;
                                border: 0 !important;
                                overflow-wrap: anywhere;
                            }
                            .mkp-wholesale-statement-table tbody tr {
                                page-break-inside: avoid;
                            }
                            .mkp-wholesale-statement-table tbody tr:nth-child(odd) td {
                                background: #f4f7f9 !important;
                            }
                            .mkp-wholesale-statement-table tbody tr:nth-child(even) td {
                                background: #ffffff !important;
                            }
                            .mkp-wholesale-statement-table tbody tr td:first-child {
                                border-radius: 4px 0 0 4px;
                            }
                            .mkp-wholesale-statement-table tbody tr td:last-child {
                                border-radius: 0 4px 4px 0;
                            }
                            .mkp-wholesale-statement-table .mkp-type {
                                color: #17384d;
                                font-weight: 700;
                            }
                            .mkp-wholesale-statement-table .mkp-amount,
                            .mkp-wholesale-statement-table .mkp-date {
                                white-space: nowrap;
                                overflow-wrap: normal;
                            }
                            .mkp-wholesale-statement-table tfoot td {
                                padding: 9px 4px;
                                background: #e7eef2 !important;
                                color: #17384d;
                                font-weight: 700;
                            }
                            .mkp-wholesale-statement-table tfoot td:first-child {
                                border-radius: 5px 0 0 5px;
                            }
                            .mkp-wholesale-statement-table tfoot td:last-child {
                                border-radius: 0 5px 5px 0;
                            }
                            .mkp-billing-contact {
                                max-width: 100%;
                                text-align: left !important;
                                line-height: 1.35;
                            }
                            .mkp-billing-contact > .text-muted {
                                color: #17384d !important;
                                font-weight: 600;
                            }
                            .mkp-billing-contact .mkp-contact-line {
                                overflow-wrap: anywhere;
                            }
                            .mkp-billing-contact .mkp-customer-name {
                                margin-bottom: 2px;
                                color: #17384d;
                                font-size: 13px;
                            }
                        </style>
                        <div class="row align-items-start mb-4">
                            <div class="col-6 mkp-billing-contact">
                                <div class="text-muted">Cliente de facturación</div>
                                <div class="mkp-customer-name">
                                    <strong t-out="group['partner'].name or group['partner'].display_name"/>
                                </div>
                                <div class="mkp-contact-line"
                                     t-if="group['partner'].street"
                                     t-out="group['partner'].street"/>
                                <div class="mkp-contact-line"
                                     t-if="group['partner'].street2"
                                     t-out="group['partner'].street2"/>
                                <div class="mkp-contact-line"
                                     t-if="group['partner'].city or group['partner'].state_id or group['partner'].zip">
                                    <span t-if="group['partner'].zip"
                                          t-out="group['partner'].zip"/>
                                    <span t-if="group['partner'].city">
                                        <t t-if="group['partner'].zip"> </t>
                                        <t t-out="group['partner'].city"/>
                                    </span>
                                    <span t-if="group['partner'].state_id">
                                        <t t-if="group['partner'].city">, </t>
                                        <t t-out="group['partner'].state_id.name"/>
                                    </span>
                                </div>
                                <div class="mkp-contact-line"
                                     t-if="group['partner'].country_id"
                                     t-out="group['partner'].country_id.name"/>
                                <div class="mkp-contact-line">
                                    <span t-if="group['partner'].vat">
                                        RFC: <span t-out="group['partner'].vat"/>
                                    </span>
                                    <span class="ms-3" t-if="group['partner'].phone">
                                        Tel: <span t-out="group['partner'].phone"/>
                                    </span>
                                    <span class="ms-3" t-if="group['partner'].email"
                                          t-out="group['partner'].email"/>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <h2 class="mb-1">Estado de cuenta Mayoreo</h2>
                                <div class="text-muted">
                                    Generado el
                                    <span t-out="generated_at_text"/>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-4">
                                <div class="px-2 py-1">
                                    <div class="text-muted">Monto neto</div>
                                    <strong class="fs-4"
                                            t-out="group['net_amount']"
                                            t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="px-2 py-1">
                                    <div class="text-muted">Monto pagado</div>
                                    <strong class="fs-4 text-success"
                                            t-out="group['paid_amount']"
                                            t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="px-2 py-1">
                                    <div class="text-muted">Monto adeudado</div>
                                    <strong class="fs-4"
                                            t-out="group['amount_due']"
                                            t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </div>
                            </div>
                        </div>

                        <table class="mkp-wholesale-statement-table">
                            <colgroup>
                                <col style="width: 12%;"/>
                                <col style="width: 13%;"/>
                                <col style="width: 18%;"/>
                                <col style="width: 12%;"/>
                                <col style="width: 15%;"/>
                                <col style="width: 15%;"/>
                                <col style="width: 15%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Referencia cliente</th>
                                    <th>Orden</th>
                                    <th class="text-end">Monto neto</th>
                                    <th class="text-end">Monto pagado</th>
                                    <th class="text-end">Monto adeudado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="group['statement_lines']" t-as="line">
                                    <td class="mkp-date" t-out="line['date_text'] or '-'"/>
                                    <td class="mkp-type">
                                        <strong t-out="line['operation_type']"/>
                                    </td>
                                    <td t-out="line['customer_reference'] or '-'"/>
                                    <td t-out="line['sale_order'] or '-'"/>
                                    <td class="text-end mkp-amount">
                                        <span t-if="line['net_amount']"
                                              t-out="line['net_amount']"
                                              t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                        <span t-else="">—</span>
                                    </td>
                                    <td class="text-end mkp-amount">
                                        <span t-if="line['paid_amount']"
                                              t-out="line['paid_amount']"
                                              t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                        <span t-else="">—</span>
                                    </td>
                                    <td class="text-end mkp-amount"
                                        t-out="line['amount_due']"
                                        t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="6">Importe total adeudado</td>
                                    <td class="text-end mkp-amount"
                                        t-out="group['amount_due']"
                                        t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_wholesale_statement" model="ir.actions.report">
        <field name="name">Estado de cuenta Mayoreo</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mkp_collection_control.report_wholesale_statement</field>
        <field name="report_file">mkp_collection_control.report_wholesale_statement</field>
        <field name="print_report_name">'Estado_cuenta_Mayoreo_%s' % (object.partner_invoice_id.name or object.name)</field>
    </record>

    <record id="view_sale_order_wholesale_statement_list" model="ir.ui.view">
        <field name="name">sale.order.wholesale.statement.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Estado de clientes Mayoreo" create="0" delete="0"
                  default_order="partner_invoice_id,name desc"
                  decoration-danger="mkp_wholesale_customer_amount_due &gt; 0"
                  decoration-success="mkp_wholesale_customer_amount_due &lt;= 0">
                <header>
                    <button name="%(action_report_wholesale_statement)d"
                            type="action" string="Generar PDF"
                            class="btn-primary" icon="fa-file-pdf-o"/>
                </header>
                <field name="partner_invoice_id" string="Cliente"/>
                <field name="name" string="Orden de venta"/>
                <field name="client_order_ref" string="Referencia del cliente"/>
                <field name="mkp_wholesale_customer_payment_state" string="Estado"
                       widget="badge"
                       decoration-warning="mkp_wholesale_customer_payment_state == 'pending'"
                       decoration-success="mkp_wholesale_customer_payment_state == 'paid'"/>
                <field name="amount_total" string="Total de la orden"
                       optional="hide" sum="Total de órdenes"/>
                <field name="mkp_wholesale_customer_net" string="Monto neto"/>
                <field name="mkp_wholesale_paid" string="Monto pagado"/>
                <field name="mkp_wholesale_customer_amount_due" string="Monto adeudado"/>
                <field name="mkp_wholesale_payment_dates" string="Fechas de pago"/>
                <field name="mkp_wholesale_last_payment_date" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_wholesale_statement_search" model="ir.ui.view">
        <field name="name">sale.order.wholesale.statement.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Buscar estado de clientes Mayoreo">
                <field name="partner_invoice_id" string="Cliente"/>
                <field name="name" string="Orden de venta"/>
                <field name="client_order_ref"/>
                <field name="user_id"/>
                <field name="mkp_wholesale_customer_payment_state" string="Estado"/>
                <filter name="pending_orders" string="Pendiente"
                        domain="[('mkp_wholesale_customer_payment_state','=','pending')]"/>
                <filter name="paid_orders" string="Pagado"
                        domain="[('mkp_wholesale_customer_payment_state','=','paid')]"/>
                <separator/>
                <filter name="group_customer" string="Cliente"
                        context="{'group_by':'partner_invoice_id'}"/>
                <filter name="group_salesperson" string="Vendedor"
                        context="{'group_by':'user_id'}"/>
                <filter name="group_order_month" string="Mes del pedido"
                        context="{'group_by':'date_order:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_wholesale_customer_statement" model="ir.actions.act_window">
        <field name="name">Estado de clientes Mayoreo</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_order_wholesale_statement_list"/>
        <field name="search_view_id" ref="view_sale_order_wholesale_statement_search"/>
        <field name="domain">[('mkp_collection_type','=','wholesale')]</field>
        <field name="context">{'create': False, 'search_default_pending_orders': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay pedidos de Mayoreo.</p>
        </field>
    </record>
</odoo>
