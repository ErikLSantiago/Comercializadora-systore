<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_payment_embedded_list" model="ir.ui.view">
        <field name="name">systore.purchase.payment.embedded.list</field>
        <field name="model">systore.purchase.payment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="concept"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_mxn" sum="Total pagado"/>
                <field name="reference"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_order_form_supply_payment" model="ir.ui.view">
        <field name="name">purchase.order.form.supply.payment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="systore_payment_status" widget="badge"
                       decoration-danger="systore_payment_status == 'pending'"
                       decoration-warning="systore_payment_status == 'partial'"
                       decoration-success="systore_payment_status == 'paid'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pagos y abastecimiento" name="systore_payments_supply">
                    <group>
                        <group string="Clasificación">
                            <field name="systore_purchase_origin"/>
                            <div class="text-muted">La detección automática considera internacional una compra con costos capturados en USD.</div>
                        </group>
                        <group string="Control manual de pago">
                            <field name="systore_company_currency_id" invisible="1"/>
                            <field name="systore_amount_payable_mxn"/>
                            <field name="systore_amount_paid_mxn" readonly="1"/>
                            <field name="systore_amount_pending_mxn" readonly="1"/>
                            <field name="systore_payment_status" widget="badge" readonly="1"
                                   decoration-danger="systore_payment_status == 'pending'"
                                   decoration-warning="systore_payment_status == 'partial'"
                                   decoration-success="systore_payment_status == 'paid'"/>
                            <button name="action_systore_use_cost_as_payable" type="object"
                                    string="Usar costo de la orden" class="btn-secondary"
                                    help="Copia el costo operativo calculado como monto total a pagar."/>
                        </group>
                    </group>
                    <separator string="Abonos registrados"/>
                    <field name="systore_payment_line_ids"
                           mode="list"
                           context="{'default_partner_id': partner_id, 'list_view_ref': 'systore_purchase_supply_dashboard.view_purchase_payment_embedded_list', 'form_view_ref': 'systore_purchase_supply_dashboard.view_purchase_payment_form'}"/>
                    <div class="alert alert-info" role="alert">
                        Este control es operativo. No crea pagos, asientos ni conciliaciones contables.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_list_supply_payment" model="ir.ui.view">
        <field name="name">purchase.order.list.supply.payment</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="systore_payment_status" widget="badge" optional="show"
                       decoration-danger="systore_payment_status == 'pending'"
                       decoration-warning="systore_payment_status == 'partial'"
                       decoration-success="systore_payment_status == 'paid'"/>
                <field name="systore_amount_pending_mxn" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
