<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_upc_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.upc.wizard.form</field>
        <field name="model">stock.picking.upc.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar productos por UPC/EAN">
                <sheet>
                    <group>
                        <field name="picking_id" invisible="not picking_id"/>
                        <field name="batch_id" invisible="not batch_id"/>
                        <field name="picking_type_id" invisible="not picking_id"/>
                        <field name="require_tracking_on_pack" invisible="1"/>
                        <field name="require_serial_imei" invisible="1"/>
                        <field name="mass_capture_available" invisible="1"/>
                        <field name="capture_massive" string="Captura masiva" invisible="not mass_capture_available"/>
                        <field name="tracking_ref" string="Número de guía" placeholder="Escanee o capture la guía" invisible="not require_tracking_on_pack" readonly="skip_tracking_ref"/>
                        <field name="skip_tracking_ref" string="No asignar número de guía" invisible="not require_tracking_on_pack"/>
                    </group>
                    <p class="text-muted" invisible="capture_massive">
                        Escanee el UPC/EAN del producto físico. En operaciones de empaque, también capture el NS/IMEI. Si elimina líneas, sólo se procesarán las líneas restantes y Odoo conservará su flujo nativo de parcial/backorder.
                    </p>
                    <p class="text-muted" invisible="not capture_massive">
                        Valide una sola vez el UPC/EAN de cada producto e indique las piezas a procesar. Al continuar se abrirá la captura de múltiples NS/IMEI. La cantidad puede reducirse para generar un movimiento parcial.
                    </p>
                    <field name="line_ids" mode="list">
                        <list editable="bottom" create="0" delete="1">
                            <field name="scan_no" string="#" force_save="1"/>
                            <field name="product_id" force_save="1"/>
                            <field name="lot_id" optional="hide" column_invisible="1" force_save="1"/>
                            <field name="demand_qty" string="Piezas disponibles" force_save="1"/>
                            <field name="processed_qty" string="Piezas a procesar" column_invisible="not parent.capture_massive"/>
                            <field name="upc_ean" placeholder="Escanee UPC/EAN" readonly="skip_upc_validation"/>
                            <field name="skip_upc_validation" string="El producto no cuenta con UPC/EAN"/>
                            <field name="serial_imei" string="NS/IMEI" placeholder="Escanee o capture NS/IMEI" column_invisible="not parent.require_serial_imei or parent.capture_massive" readonly="skip_upc_validation"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar y validar traslado" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_stock_picking_mass_serial_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.mass.serial.wizard.form</field>
        <field name="model">stock.picking.mass.serial.wizard</field>
        <field name="arch" type="xml">
            <form string="Capturar múltiples NS/IMEI">
                <sheet>
                    <group>
                        <field name="picking_id"/>
                    </group>
                    <p class="text-muted">
                        Capture un NS/IMEI por cada pieza. No se permiten valores vacíos, repetidos ni números ya registrados.
                    </p>
                    <field name="line_ids" mode="list">
                        <list editable="bottom" create="0" delete="0">
                            <field name="product_id"/>
                            <field name="scan_no" string="#"/>
                            <field name="serial_imei" string="NS/IMEI" placeholder="Escanee o capture NS/IMEI"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar y validar traslado" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
