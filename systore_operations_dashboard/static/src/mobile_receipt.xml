<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="systore_operations_dashboard.MobileReceipt">
<div class="smp-shell">
    <header class="smp-header">
        <button class="smp-icon-button" t-on-click="back" t-att-disabled="state.busy" aria-label="Volver"><i class="fa fa-arrow-left"/></button>
        <div><small>INGRESOS · <t t-esc="state.detail?.warehouse || state.panel?.warehouse || ''"/></small>
            <h1 t-esc="state.detail &amp;&amp; ['capture','confirm'].includes(state.page) ? state.detail.name : 'Órdenes por ingresar'"/></div>
        <button t-if="state.page === 'panel'" class="smp-icon-button" t-on-click="() => this.loadPanel(state.pageNumber)" t-att-disabled="state.busy" aria-label="Actualizar"><i class="fa fa-refresh"/></button>
    </header>
    <main class="smp-main">
        <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
        <div t-if="state.message" class="alert alert-success" role="status" t-esc="state.message"/>
        <p t-if="state.busy" role="status"><i class="fa fa-spinner fa-spin"/> Procesando…</p>
        <t t-if="state.page === 'panel'">
            <label class="smp-search"><span class="visually-hidden">Buscar compra</span><input type="search" t-model="state.query" t-on-keydown="searchKey" placeholder="Buscar compra, origen, proveedor, producto o UPC"/><button class="smp-link" t-on-click="search" t-att-disabled="state.busy">Buscar</button></label>
            <div class="smp-grid">
                <button t-foreach="cards" t-as="card" t-key="card.key" class="smp-card smp-operation" t-on-click="() => this.openCard(card)" t-att-disabled="state.busy">
                    <span class="smp-kind">ORDEN DE COMPRA / RECEPCIÓN</span><h2 t-esc="card.name"/>
                    <span class="smp-label">Documento de origen</span><p t-esc="card.origin || '—'"/>
                    <span class="smp-label">Proveedor</span><p t-esc="card.supplier"/>
                    <span class="smp-label">Referencia del proveedor</span><p t-esc="card.supplier_ref || '—'"/>
                    <div class="smp-metrics"><span><strong t-esc="format(card.pieces)"/> piezas pendientes</span><span><strong t-esc="format(card.packages)"/> cajas OC</span></div>
                    <small><t t-esc="card.receipts.length"/> recepciones</small><div class="smp-open">Ingresar <i class="fa fa-arrow-right"/></div>
                </button>
            </div>
            <p t-if="state.panel &amp;&amp; !cards.length &amp;&amp; !state.busy" class="smp-empty">No hay compras pendientes para este filtro.</p>
            <nav class="smp-pagination" t-if="state.panel" aria-label="Páginas">
                <button t-att-disabled="state.busy || !state.pageNumber" t-on-click="() => this.loadPanel(state.pageNumber - 1)">Anterior</button>
                <span>Página <t t-esc="state.pageNumber + 1"/></span>
                <button t-att-disabled="state.busy || !state.panel.has_more" t-on-click="() => this.loadPanel(state.pageNumber + 1)">Siguiente</button>
            </nav>
        </t>
        <t t-if="state.page === 'operations'">
            <h2 t-esc="state.receiptCard.name"/>
            <div class="smp-grid"><button t-foreach="state.receiptCard.receipts" t-as="receipt" t-key="receipt.picking_id"
                class="smp-card smp-operation" t-on-click="() => this.openReceipt(receipt.picking_id)" t-att-disabled="state.busy">
                <h3 t-esc="receipt.name"/><span class="smp-badge" t-esc="label(receipt.state)"/>
                <p><t t-esc="format(receipt.pieces)"/> piezas</p><div class="smp-open">Abrir recepción <i class="fa fa-arrow-right"/></div>
            </button></div>
        </t>
        <t t-if="state.page === 'products' &amp;&amp; state.detail">
            <div class="smp-detail-heading"><h2>Productos por ingresar</h2><button class="smp-link" t-on-click="original" t-att-disabled="state.busy">Abrir original</button></div>
            <p t-esc="state.detail.purchase_names"/>
            <div t-if="state.detail.notice" class="alert alert-warning" t-esc="state.detail.notice"/>
            <div class="smp-grid"><button t-foreach="state.captures" t-as="row" t-key="row.id" class="smp-card smp-operation" t-on-click="() => this.openProduct(row_index)" t-att-disabled="state.busy || !state.detail.can_validate">
                <div class="smp-product-heading"><div class="smp-product-image"><i class="fa fa-cube"/><img t-att-src="imageURL(row.product_id)" t-att-alt="row.product" width="96" height="96" t-on-error="imageError"/></div><h3 t-esc="row.product"/></div>
                <div class="smp-quantity"><span>Solicitadas</span><strong t-esc="format(row.qty)"/><span t-esc="row.uom"/></div>
                <div t-if="row.reviewed" class="smp-quantity smp-registered"><span>Registradas</span><strong t-esc="format(row.quantity)"/><span t-esc="row.uom"/></div><p t-else="">Sin registrar</p>
            </button></div>
            <button class="smp-primary w-100 mt-3" t-on-click="review" t-att-disabled="state.busy || !ready">Finalizar registro</button>
        </t>
        <t t-if="state.page === 'capture' &amp;&amp; current">
            <div class="smp-detail-heading"><h2>Producto por ingresar</h2><span><t t-esc="state.index + 1"/> / <t t-esc="state.captures.length"/></span></div>
            <div class="smp-detail-heading"><span t-esc="state.detail.purchase_names"/><button class="smp-link" t-on-click="original" t-att-disabled="state.busy">Abrir original</button></div>
            <div t-if="state.detail.notice" class="alert alert-warning" t-esc="state.detail.notice"/>
            <div t-if="state.detail.multi_purchase" class="alert alert-info">Esta recepción incluye varias compras; se procesan los productos mostrados.</div>
            <article class="smp-card">
                <div class="smp-product-heading"><div class="smp-product-image"><i class="fa fa-cube"/>
                    <img t-att-src="imageURL(current.product_id)" t-att-alt="current.product" width="96" height="96" t-on-error="imageError"/></div><h3 t-esc="current.product"/></div>
                <div class="smp-quantity"><span>Cantidad a recibir</span><strong t-esc="format(current.qty)"/><span t-esc="current.uom"/></div>
                <label class="smp-field">Productos recibidos<input type="number" min="0" t-att-max="current.qty" step="any" t-att-value="current.quantity === null ? '' : current.quantity" t-on-input="setQuantity" t-att-disabled="state.busy || !state.detail.can_validate" placeholder="Capturar cantidad"/></label>
                <label class="smp-field">Escanear UPC<input t-ref="upcInput" t-att-value="current.upc" t-on-input="setUPC" autocomplete="off" placeholder="Escanear UPC" t-att-disabled="state.busy || current.quantity === 0 || !state.detail.can_validate"/></label>
                <p t-if="current.quantity === 0" class="smp-muted">Este producto quedará pendiente.</p>
                <button class="smp-primary w-100" t-on-click="() => this.next(1)" t-att-disabled="state.busy || !state.detail.can_validate">Confirmar producto</button>
            </article>
        </t>
        <t t-if="state.page === 'confirm'">
            <h2>Confirmar ingreso</h2><p t-esc="state.detail.purchase_names"/>
            <div t-foreach="state.captures" t-as="row" t-key="row.id" class="smp-card mb-2"><strong t-esc="row.product"/><p>Recibidos: <t t-esc="format(row.reviewed ? row.quantity : 0)"/> de <t t-esc="format(row.qty)"/></p></div>
            <p t-if="state.captures.some(row => !row.reviewed || row.quantity &lt; row.qty)" class="alert alert-info">Ingreso parcial. Confirme la recepción pendiente en el asistente de Odoo.</p>
            <button class="smp-primary w-100" t-on-click="validate" t-att-disabled="state.busy || !ready">Confirmar ingreso</button>
        </t>
        <div t-if="state.page === 'pending'" class="smp-empty"><p>Complete el asistente de Odoo para aceptar la parcialización.</p><button class="smp-link" t-on-click="() => this.loadPanel()">Volver al panel</button></div>
    </main>
</div>
</t>
</templates>
