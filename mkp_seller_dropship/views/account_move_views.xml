<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_mkp_seller_traceability" model="ir.ui.view">
        <field name="name">account.move.form.mkp.seller.traceability</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="mkp_parent_order_ref"
                       readonly="1"
                       invisible="not mkp_parent_order_ref"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="mkp_seller_order_id" readonly="1" optional="show"/>
                <field name="mkp_seller_id" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
