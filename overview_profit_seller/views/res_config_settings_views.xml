<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_seller_profit" model="ir.ui.view">
        <field name="name">res.config.settings.form.seller.profit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Ingresos por comisiones">
                    <setting string="Empresa del tablero de comisiones"
                             help="El tablero se habilita al seleccionar esta empresa como compañía activa. Deja el campo vacío para deshabilitarlo."
                             groups="base.group_system">
                        <field name="seller_sales_profit_company_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
