<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_wholesale_allocation" model="ir.ui.view">
        <field name="name">sale.order.form.wholesale.allocation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Wholesale Allocation" invisible="not is_wholesale_allocation">
                    <group>
                        <field name="is_wholesale_allocation" invisible="1"/>
                        <field name="associated_purchase_order_ids"
                               widget="many2many_tags"
                               domain="[('state', 'in', ['purchase', 'done'])]"
                               options="{'no_create': True}"/>
                        <div class="text-muted"><span>La reserva automática sólo utilizará lotes cuyo nombre coincida con las Órdenes de Compra asociadas. Los lotes externos todavía pueden asignarse manualmente en la entrega.</span></div>
                    </group>
                </page>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_associated_purchase_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="associated_purchase_order_count == 0">
                    <field name="associated_purchase_order_count" widget="statinfo" string="OC asociadas"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
