<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_mkp_collection" model="ir.module.category">
        <field name="name">Cobranza MKP</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_mkp_collection_operator" model="res.groups">
        <field name="name">Operador</field>
        <field name="category_id" ref="module_category_mkp_collection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_mkp_collection_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_category_mkp_collection"/>
        <field name="implied_ids" eval="[(4, ref('group_mkp_collection_operator'))]"/>
    </record>
    <record id="rule_mkp_collection_order_company" model="ir.rule">
        <field name="name">Cobranza: empresas permitidas</field>
        <field name="model_id" ref="model_mkp_collection_order"/>
        <field name="groups" eval="[(4, ref('group_mkp_collection_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mkp_collection_event_company" model="ir.rule">
        <field name="name">Historial cobranza: empresas permitidas</field>
        <field name="model_id" ref="model_mkp_collection_event"/>
        <field name="groups" eval="[(4, ref('group_mkp_collection_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
