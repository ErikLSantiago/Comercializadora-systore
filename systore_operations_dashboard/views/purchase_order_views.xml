<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_expected_packages" model="ir.ui.view">
        <field name="name">purchase.order.expected.packages</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='date_planned_div']" position="after">
                <field name="systore_expected_packages" readonly="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
