<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_systore_sales_cost_import_wizard_form" model="ir.ui.view">
        <field name="name">systore.sales.cost.import.wizard.form</field>
        <field name="model">systore.sales.cost.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar costos">
                <group>
                    <div class="alert alert-info" role="alert">
                        Sube un archivo .xlsx o .csv con dos columnas: <strong>ID línea</strong> y <strong>Costo unitario</strong>.
                        Solo se actualizarán líneas sin costo automático de Orden de compra.
                    </div>
                    <field name="file_data" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_systore_sales_cost_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar costos</field>
        <field name="res_model">systore.sales.cost.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_systore_sales_cost_import_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
