<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_guided_button" model="ir.ui.view">
        <field name="name">stock.picking.batch.guided.button</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_systore_guided_batch" type="object" string="Operar desde tablero"
                        invisible="state in ('done', 'cancel')" groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>
    <record id="view_guided_upc_form" model="ir.ui.view">
        <field name="name">systore.guided.upc.form</field>
        <field name="model">stock.picking.upc.wizard</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form string="Preparar pedidos" create="0">
                <sheet>
                    <group>
                        <field name="systore_guided_warehouse_id" invisible="1"/>
                        <field name="systore_guided_section" invisible="1"/>
                        <field name="require_serial_imei" invisible="1"/>
                        <field name="require_tracking_on_pack" invisible="1"/>
                        <field name="batch_id" readonly="1" invisible="not batch_id"/>
                        <field name="picking_id" readonly="1" invisible="not picking_id"/>
                        <field name="systore_order_names" string="Órdenes de venta"/>
                        <field name="tracking_ref" string="Número de guía" placeholder="Escanee la guía del paquete"
                               invisible="not require_tracking_on_pack" required="require_tracking_on_pack"/>
                    </group>
                    <p class="text-muted" invisible="require_serial_imei">Registre las piezas recolectadas y escanee el UPC de cada producto. El batch suma las piezas de todas sus órdenes. Las cantidades parciales conservan el asistente de pedido pendiente de Odoo.</p>
                    <p class="text-muted" invisible="not require_serial_imei">Escanee UPC y NS/IMEI por pieza; después capture la guía de esta orden. La validación guardará las series adicionales y avanzará a la siguiente operación.</p>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="systore_order_names"/>
                            <field name="product_id" readonly="1"/>
                            <field name="systore_requested_qty" sum="Solicitadas"/>
                            <field name="demand_qty" string="Recolectadas" sum="Recolectadas"
                                   readonly="parent.require_serial_imei" column_invisible="parent.require_serial_imei"/>
                            <field name="upc_ean" placeholder="Escanee UPC/EAN"/>
                            <field name="serial_imei" string="NS/IMEI" placeholder="Escanee NS/IMEI"
                                   column_invisible="not parent.require_serial_imei"/>
                            <field name="systore_scanned_qty" string="Capturadas" sum="Capturadas"
                                   column_invisible="not parent.require_serial_imei"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Validar y continuar" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_guided_picking_list" model="ir.ui.view">
        <field name="name">systore.guided.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list create="0" string="Pedidos para preparar">
                <field name="name"/>
                <field name="systore_operations_sale_names"/>
                <field name="batch_id" optional="show"/>
                <field name="picking_type_id"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
                <button name="action_systore_guided_operation" type="object" string="Operar" class="btn-primary"/>
            </list>
        </field>
    </record>
</odoo>
