<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_form_supply_channel" model="ir.ui.view">
        <field name="name">stock.warehouse.form.supply.channel</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="wholesale_allocation.view_warehouse_form_wholesale_allocation"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Tablero de abastecimiento" groups="base.group_system">
                    <field name="systore_supply_management"/>
                    <field name="systore_resolved_supply_channel" widget="badge" readonly="1"/>
                    <div class="text-muted">Los almacenes Sin gestión para compras no aparecen en demanda, recepciones, deuda ni rankings.</div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_supply_configuration_list" model="ir.ui.view">
        <field name="name">stock.warehouse.supply.configuration.list</field>
        <field name="model">stock.warehouse</field>
        <field name="arch" type="xml">
            <list string="Almacenes y canales" editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="code" readonly="1"/>
                <field name="company_id" optional="show" readonly="1"/>
                <field name="systore_supply_management"/>
            </list>
        </field>
    </record>

    <record id="action_warehouse_supply_configuration" model="ir.actions.act_window">
        <field name="name">Almacenes y canales</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_warehouse_supply_configuration_list"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
