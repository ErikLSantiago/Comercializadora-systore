<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_systore_sales_cost_rebuild_wizard_form" model="ir.ui.view">
        <field name="name">systore.sales.cost.rebuild.wizard.form</field>
        <field name="model">systore.sales.cost.rebuild.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconstruir reporte consolidado">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_rebuild" type="object" string="Reconstruir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_systore_sales_cost_rebuild" model="ir.actions.act_window">
        <field name="name">Actualizar reporte</field>
        <field name="res_model">systore.sales.cost.rebuild.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
