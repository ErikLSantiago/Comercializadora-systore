<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="systore_operations_dashboard.Dashboard">
        <div class="systore-operations-dashboard">
            <header class="sod-header">
                <div>
                    <div class="sod-eyebrow">INVENTARIO</div>
                    <h1>Tablero de operaciones</h1>
                    <p>Planifica la jornada y abre cada operación para trabajarla.</p>
                </div>
                <div t-if="state.warehouseId" class="sod-warehouse">
                    <button class="btn btn-link" t-on-click="warehouseHome" t-att-disabled="state.loading"><i class="fa fa-arrow-left me-1"/> Almacenes</button>
                    <label for="sod-warehouse">Almacén</label>
                    <select id="sod-warehouse" class="form-select" t-on-change="changeWarehouse"
                            t-att-disabled="state.loading || !state.warehouses.length">
                        <option t-if="!state.warehouses.length" value="">Sin almacenes asignados</option>
                        <option t-foreach="state.warehouses" t-as="warehouse" t-key="warehouse.id"
                                t-att-value="warehouse.id" t-att-selected="warehouse.id === state.warehouseId">
                            <t t-esc="warehouse.code"/> · <t t-esc="warehouse.name"/> — <t t-esc="warehouse.company"/>
                        </option>
                    </select>
                </div>
            </header>

            <div t-if="state.warehouseId" class="sod-toolbar">
                <div class="sod-date-buttons" role="group" aria-label="Filtros de fecha">
                    <button class="btn" t-att-class="{'btn-primary': state.scope === 'date' &amp;&amp; state.date === state.today, 'btn-outline-secondary': !(state.scope === 'date' &amp;&amp; state.date === state.today)}"
                            t-on-click="() => this.filter('today')" t-att-disabled="state.loading">Hoy</button>
                    <button class="btn" t-att-class="{'btn-primary': state.scope === 'date' &amp;&amp; state.date === tomorrow, 'btn-outline-secondary': !(state.scope === 'date' &amp;&amp; state.date === tomorrow)}"
                            t-on-click="() => this.filter('tomorrow')" t-att-disabled="state.loading">Mañana</button>
                    <button class="btn" t-att-class="{'btn-primary': state.scope === 'overdue', 'btn-outline-secondary': state.scope !== 'overdue'}"
                            t-on-click="() => this.filter('overdue')" t-att-disabled="state.loading">Atrasadas</button>
                    <button class="btn" t-att-class="{'btn-primary': state.scope === 'all', 'btn-outline-secondary': state.scope !== 'all'}"
                            t-on-click="() => this.filter('all')" t-att-disabled="state.loading">Todas</button>
                    <button class="btn" t-att-class="{'btn-primary': state.scope === 'undated', 'btn-outline-secondary': state.scope !== 'undated'}"
                            t-on-click="() => this.filter('undated')" t-att-disabled="state.loading">Sin fecha</button>
                </div>
                <div class="sod-date-input">
                    <label for="sod-date">Consultar fecha</label>
                    <input id="sod-date" type="date" class="form-control" t-att-value="state.date"
                           t-on-change="chooseDate" t-att-disabled="state.loading"/>
                </div>
                <button class="btn btn-outline-secondary sod-refresh" t-on-click="reload" t-att-disabled="state.loading">
                    <i class="fa fa-refresh me-2" aria-hidden="true"/>Actualizar
                </button>
            </div>

            <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/></div>
            <div t-elif="state.loading" class="sod-empty" role="status">
                <i class="fa fa-spinner fa-spin me-2" aria-hidden="true"/>Consultando operaciones…
            </div>
            <div t-elif="!state.warehouses.length" class="sod-empty">
                <i class="fa fa-building-o sod-empty-icon" aria-hidden="true"/>
                <h2>No tienes almacenes asignados</h2>
                <p>Un administrador debe habilitar el tablero y asignarte en Inventario → Configuración → Almacenes.</p>
            </div>
            <div t-elif="!state.warehouseId" class="sod-warehouse-home">
                <h2>Selecciona un almacén</h2>
                <div class="sod-warehouse-grid">
                    <button t-foreach="state.warehouses" t-as="warehouse" t-key="warehouse.id"
                            class="sod-warehouse-card" t-on-click="() => this.selectWarehouse(warehouse.id)">
                        <i class="fa fa-building-o" aria-hidden="true"/>
                        <strong t-esc="warehouse.name"/><span><t t-esc="warehouse.code"/> · <t t-esc="warehouse.company"/></span>
                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                    </button>
                </div>
            </div>
            <t t-elif="state.data">
                <div class="sod-period">
                    <strong t-esc="dateLabel"/>
                    <span>Solo operaciones pendientes · Existencias: <t t-esc="state.data.stock_location"/></span>
                </div>
                <div class="sod-cards">
                    <article t-foreach="state.data.sections" t-as="section" t-key="section.key"
                             class="sod-card" t-att-class="'sod-card-' + section.key">
                        <div class="sod-card-title">
                            <h2 t-esc="section.title"/>
                            <i class="fa" t-att-class="{'fa-arrow-down': isReceipt(section.key), 'fa-exchange': section.key === 'transfers', 'fa-hand-paper-o': section.key === 'pick', 'fa-archive': section.key === 'pack', 'fa-truck': section.key === 'out'}" aria-hidden="true"/>
                        </div>
                        <div class="sod-main-count">
                            <strong t-esc="format(isReceipt(section.key) ? section.selected.orders : section.selected.operations)"/>
                            <span t-esc="isReceipt(section.key) ? 'órdenes de compra' : 'operaciones'"/>
                        </div>
                        <div t-if="isReceipt(section.key)" class="sod-secondary-count">
                            <strong t-esc="format(section.selected.packages)"/> bultos esperados
                            <span>· <t t-esc="format(section.selected.pieces)"/> piezas</span>
                        </div>
                        <div t-else="" class="sod-secondary-count">
                            <strong t-esc="format(section.selected.pieces)"/> piezas ·
                            <t t-esc="format(section.selected.batches)"/> batches
                            <br/>
                            <t t-if="section.key === 'transfers'">Salidas desde Existencias y sus sububicaciones</t>
                            <t t-elif="section.key === 'pick'">Todas las recolecciones pendientes</t>
                            <t t-elif="section.key === 'pack'">Empaquetado de pedidos</t>
                            <t t-else="">Salida y entrega de pedidos</t>
                        </div>
                        <div t-if="section.key !== 'pick'" class="sod-mini-counts">
                            <button t-on-click="() => this.filter('today')" class="sod-mini">
                                <span>Hoy</span><strong t-esc="format(isReceipt(section.key) ? section.today.orders : section.today.operations)"/>
                                <small t-if="isReceipt(section.key)"><t t-esc="format(section.today.packages)"/> bultos</small>
                                <small t-if="isReceipt(section.key)"><t t-esc="format(section.today.pieces)"/> piezas</small>
                                <small t-else=""><t t-esc="format(section.today.pieces)"/> piezas</small>
                            </button>
                            <button t-on-click="() => this.filter('tomorrow')" class="sod-mini">
                                <span>Mañana</span><strong t-esc="format(isReceipt(section.key) ? section.tomorrow.orders : section.tomorrow.operations)"/>
                                <small t-if="isReceipt(section.key)"><t t-esc="format(section.tomorrow.packages)"/> bultos</small>
                                <small t-if="isReceipt(section.key)"><t t-esc="format(section.tomorrow.pieces)"/> piezas</small>
                                <small t-else=""><t t-esc="format(section.tomorrow.pieces)"/> piezas</small>
                            </button>
                            <button t-on-click="() => this.filter('overdue')" class="sod-mini sod-overdue">
                                <span>Atrasadas</span><strong t-esc="format(isReceipt(section.key) ? section.overdue.orders : section.overdue.operations)"/>
                                <small t-if="isReceipt(section.key)"><t t-esc="format(section.overdue.packages)"/> bultos</small>
                                <small t-if="isReceipt(section.key)"><t t-esc="format(section.overdue.pieces)"/> piezas</small>
                                <small t-else=""><t t-esc="format(section.overdue.pieces)"/> piezas</small>
                            </button>
                        </div>
                        <div class="sod-card-actions">
                            <button t-if="section.key === 'in'" class="btn btn-primary btn-lg" t-on-click="() => this.openMobileReceipt()" t-att-disabled="state.opening">
                                <i class="fa fa-mobile me-1"/> Operar
                            </button>
                            <button t-if="section.key === 'pick'" class="btn btn-primary btn-lg" t-on-click="() => this.openMobilePick()" t-att-disabled="state.opening">
                                <i class="fa fa-mobile me-1" aria-hidden="true"/> Operar
                            </button>
                            <button class="btn" t-att-class="section.key === 'pick' ? 'btn-outline-secondary' : 'btn-primary'" t-on-click="() => this.openOperations(section.key)" t-att-disabled="state.opening">
                                Abrir operaciones <i class="fa fa-arrow-right ms-1" aria-hidden="true"/>
                            </button>
                            <button class="btn btn-link" t-on-click="() => { this.state.activeSection = section.key; }">Ver detalle</button>
                            <button t-if="['pick', 'pack', 'out'].includes(section.key)" class="btn btn-link"
                                    t-on-click="() => this.openBatches(section.key)" t-att-disabled="state.opening">Batches</button>
                        </div>
                    </article>
                </div>
                <div class="sod-detail">
                    <div class="sod-detail-header">
                        <nav class="sod-tabs" aria-label="Detalle por sección">
                            <button t-foreach="state.data.sections" t-as="section" t-key="section.key"
                                    t-att-class="{'active': state.activeSection === section.key}"
                                    t-on-click="() => { this.state.activeSection = section.key; }" t-esc="section.title"/>
                        </nav>
                        <span t-esc="state.activeSection === 'pick' ? 'Todas las pendientes' : dateLabel"/>
                    </div>
                    <t t-if="activeSection">
                        <p class="sod-table-caption" t-if="isReceipt(activeSection.key)">
                            Una fila por compra, con su referencia del proveedor, bultos y piezas solicitadas. La fecha corresponde a Fecha esperada de la compra.
                        </p>
                        <p class="sod-table-caption" t-else="">Una fila por batch o por operación sin batch. Un batch se prepara completo; sus órdenes pueden tener fechas distintas.</p>
                        <div class="sod-table-scroll" t-if="activeSection.rows.length">
                            <table class="table table-hover align-middle mb-0">
                                <thead><tr>
                                    <th t-esc="isReceipt(activeSection.key) ? 'Orden de compra / operación' : 'Operación'"/>
                                    <th t-if="isReceipt(activeSection.key)">Proveedor</th>
                                    <th t-else="">Etapa</th>
                                    <th t-if="isReceipt(activeSection.key)">Referencia del proveedor</th>
                                    <th t-elif="activeSection.key !== 'transfers'">Orden de venta</th>
                                    <t t-if="!isReceipt(activeSection.key)"><th>Batch / lotes nativos</th><th class="text-end">Piezas</th></t>
                                    <th>Fecha</th>
                                    <t t-if="isReceipt(activeSection.key)">
                                        <th class="text-end">Bultos</th><th class="text-end">Piezas</th>
                                    </t>
                                    <t t-else=""><th>Origen</th><th>Destino</th><th>Estado</th></t>
                                    <th><span class="visually-hidden">Acción</span></th>
                                </tr></thead>
                                <tbody>
                                    <tr t-foreach="activeSection.rows" t-as="row" t-key="row.key">
                                        <td class="fw-bold"><t t-esc="row.label"/><small t-if="isReceipt(activeSection.key) &amp;&amp; !row.purchase_id" class="d-block text-muted">Sin compra vinculada</small></td>
                                        <td t-esc="isReceipt(activeSection.key) ? row.partner : row.type"/>
                                        <td t-if="isReceipt(activeSection.key)" t-esc="row.supplier_ref || '—'"/>
                                        <td t-elif="activeSection.key !== 'transfers'" t-esc="row.sale_order || '—'"/>
                                        <t t-if="!isReceipt(activeSection.key)">
                                            <td><t t-esc="row.batch || 'Sin batch'"/><small t-if="row.native_lots" class="d-block text-muted" t-esc="row.native_lots"/></td>
                                            <td class="text-end" t-esc="format(row.pieces)"/>
                                        </t>
                                        <td class="text-nowrap" t-esc="displayDate(row.date)"/>
                                        <t t-if="isReceipt(activeSection.key)">
                                            <td class="text-end" t-esc="format(row.packages)"/><td class="text-end" t-esc="format(row.pieces)"/>
                                        </t>
                                        <t t-else=""><td t-esc="row.source"/><td t-esc="row.destination"/>
                                            <td><span class="sod-state" t-att-class="{'sod-state-ready': row.state === 'assigned'}" t-esc="stateLabel(row.state)"/></td>
                                        </t>
                                        <td class="text-end"><button class="btn btn-sm btn-outline-primary" t-att-disabled="state.opening"
                                            t-on-click="() => activeSection.key === 'pick' ? this.openMobilePick(row) : activeSection.key === 'in' ? this.openMobileReceipt(row) : this.openOperations(activeSection.key, row)">Operar</button></td>
                                    </tr>
                                </tbody>
                                <tfoot t-if="isReceipt(activeSection.key)">
                                    <tr class="fw-bold">
                                        <td colspan="4">Total del filtro</td>
                                        <td class="text-end" t-esc="format(activeSection.selected.packages)"/>
                                        <td class="text-end" t-esc="format(activeSection.selected.pieces)"/>
                                        <td/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div t-else="" class="sod-no-rows">No hay operaciones pendientes para este filtro.</div>
                        <div t-if="activeSection.truncated" class="sod-more">
                            Se muestran las primeras 60 filas. <button class="btn btn-link" t-on-click="() => this.openOperations(activeSection.key)">Abrir lista completa</button>
                        </div>
                    </t>
                </div>
                <p class="sod-footnote">Transferencias puede incluir Pick o una entrega directa cuando salen de Existencias. Los totales de las etapas no son acumulables: una compra o pedido puede recorrer más de una etapa.</p>
            </t>
        </div>
    </t>
</templates>
