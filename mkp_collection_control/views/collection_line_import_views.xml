<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_collection_line_import_list" model="ir.ui.view">
        <field name="name">mkp.collection.line.import.list</field>
        <field name="model">mkp.collection.line.import</field>
        <field name="arch" type="xml">
            <list string="Importación de comisiones" create="1" edit="0" delete="0"
                  import="1" default_order="id desc">
                <field name="sale_order_id"/>
                <field name="sku"/>
                <field name="line_sequence" optional="show"/>
                <field name="coupon_amount" optional="show"/>
                <field name="killer_amount" optional="show"/>
                <field name="killer_commission" optional="show"/>
                <field name="commission" optional="show"/>
                <field name="taxes" optional="show"/>
                <field name="shipping" optional="show"/>
                <field name="other_commission" optional="show"/>
                <field name="calculation_type" optional="show"/>
                <field name="payment_status" optional="show"/>
                <field name="payment_reference" optional="show"/>
                <field name="generated_history_id" optional="show"/>
                <field name="imported_by_id" optional="hide"/>
                <field name="imported_at" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_collection_line_import_form" model="ir.ui.view">
        <field name="name">mkp.collection.line.import.form</field>
        <field name="model">mkp.collection.line.import</field>
        <field name="arch" type="xml">
            <form string="Registro importado" create="0" edit="0" delete="0">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group string="Línea de venta">
                            <field name="sale_order_id"/>
                            <field name="sku"/>
                            <field name="line_sequence"/>
                            <field name="generated_history_id"/>
                        </group>
                        <group string="Promociones">
                            <field name="coupon_amount"/>
                            <field name="killer_amount"/>
                            <field name="killer_commission"/>
                        </group>
                    </group>
                    <group string="Comisiones y descuentos">
                        <field name="commission"/>
                        <field name="taxes"/>
                        <field name="shipping"/>
                        <field name="other_commission"/>
                        <field name="calculation_type"/>
                    </group>
                    <group string="Cobranza">
                        <field name="payment_status"/>
                        <field name="payment_reference"/>
                        <field name="comment"/>
                    </group>
                    <group string="Auditoría">
                        <field name="imported_by_id"/>
                        <field name="imported_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_collection_line_import_search" model="ir.ui.view">
        <field name="name">mkp.collection.line.import.search</field>
        <field name="model">mkp.collection.line.import</field>
        <field name="arch" type="xml">
            <search string="Buscar importaciones">
                <field name="sale_order_id"/>
                <field name="sku"/>
                <field name="generated_history_id"/>
                <filter name="group_order" string="Orden"
                        context="{'group_by':'sale_order_id'}"/>
                <filter name="group_date" string="Mes"
                        context="{'group_by':'imported_at:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_collection_line_import" model="ir.actions.act_window">
        <field name="name">Importar comisiones por línea</field>
        <field name="res_model">mkp.collection.line.import</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_collection_line_import_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Use Importar registros para cargar un archivo y mapear sus columnas con Odoo.</p>
            <p>Identifique cada línea con Orden de venta y SKU. Si el SKU se repite, agregue Secuencia de línea.</p>
        </field>
    </record>
</odoo>
