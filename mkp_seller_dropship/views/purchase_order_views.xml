<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_mkp_sale_link" model="ir.ui.view">
        <field name="name">purchase.order.form.mkp.sale.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="after">
                <group string="Documentos relacionados" col="2">
                    <field name="mkp_sale_order_id" options="{'no_create': True}"/>
                    <field name="mkp_seller_settlement" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
