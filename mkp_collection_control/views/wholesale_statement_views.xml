<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_wholesale_statement">
        <t t-call="web.html_container">
            <t t-foreach="customer_groups" t-as="group">
                <t t-set="o" t-value="group['orders'][0]"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .mkp-wholesale-statement-table {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .mkp-wholesale-statement-table thead th {
                                padding: 7px 6px;
                                border: 1px solid #6b7280 !important;
                                background: #f3f4f6;
                                font-weight: 700 !important;
                            }
                            .mkp-wholesale-statement-table tbody td,
                            .mkp-wholesale-statement-table tfoot td {
                                padding: 7px 6px;
                                border: 0 !important;
                            }
                            .mkp-wholesale-statement-table tfoot td {
                                padding-top: 12px;
                                font-weight: 700;
                            }
                        </style>
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h2 class="mb-1">Estado de cuenta Mayoreo</h2>
                                <div class="text-muted">
                                    Generado el
                                    <span t-out="generated_at_text"/>
                                </div>
                            </div>
                            <div class="text-end">
                                <strong t-out="group['partner'].display_name"/>
                                <div t-if="group['partner'].vat">
                                    RFC: <span t-out="group['partner'].vat"/>
                                </div>
                                <div t-if="group['partner'].email"
                                     t-out="group['partner'].email"/>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-4">
                                <div class="px-2 py-1">
                                    <div class="text-muted">Monto neto</div>
                                    <strong class="fs-4"
                                            t-out="group['net_amount']"
                                            t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="px-2 py-1">
                                    <div class="text-muted">Monto pagado</div>
                                    <strong class="fs-4 text-success"
                                            t-out="group['paid_amount']"
                                            t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="px-2 py-1">
                                    <div class="text-muted">Monto adeudado</div>
                                    <strong class="fs-4"
                                            t-out="group['amount_due']"
                                            t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                </div>
                            </div>
                        </div>

                        <table class="mkp-wholesale-statement-table">
                            <thead>
                                <tr class="table-light">
                                    <th>Tipo</th>
                                    <th>Documento</th>
                                    <th>Referencia cliente</th>
                                    <th class="text-end">Monto neto</th>
                                    <th class="text-end">Monto pagado</th>
                                    <th class="text-end">Monto adeudado</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="group['statement_lines']" t-as="line">
                                    <td>
                                        <strong t-out="line['operation_type']"/>
                                        <small class="d-block text-muted"
                                               t-if="line['payment_status']"
                                               t-out="line['payment_status']"/>
                                    </td>
                                    <td t-out="line['document'] or '-'"/>
                                    <td t-out="line['customer_reference'] or '-'"/>
                                    <td class="text-end">
                                        <span t-if="line['net_amount']"
                                              t-out="line['net_amount']"
                                              t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                        <span t-else="">—</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-if="line['paid_amount']"
                                              t-out="line['paid_amount']"
                                              t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                        <span t-else="">—</span>
                                    </td>
                                    <td class="text-end"
                                        t-out="line['amount_due']"
                                        t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                    <td t-out="line['date_text'] or '-'"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="5">Importe total adeudado</td>
                                    <td class="text-end"
                                        t-out="group['amount_due']"
                                        t-options="{'widget': 'monetary', 'display_currency': group['currency']}"/>
                                    <td/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="paperformat_wholesale_statement" model="report.paperformat">
        <field name="name">Estado de cuenta Mayoreo horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_wholesale_statement" model="ir.actions.report">
        <field name="name">Estado de cuenta Mayoreo</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mkp_collection_control.report_wholesale_statement</field>
        <field name="report_file">mkp_collection_control.report_wholesale_statement</field>
        <field name="paperformat_id" ref="paperformat_wholesale_statement"/>
        <field name="print_report_name">'Estado_cuenta_Mayoreo_%s' % (object.partner_invoice_id.name or object.name)</field>
    </record>

    <record id="view_sale_order_wholesale_statement_list" model="ir.ui.view">
        <field name="name">sale.order.wholesale.statement.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Estado de clientes Mayoreo" create="0" delete="0"
                  default_order="partner_invoice_id,name desc"
                  decoration-danger="mkp_wholesale_customer_amount_due &gt; 0"
                  decoration-success="mkp_wholesale_customer_amount_due &lt;= 0">
                <header>
                    <button name="%(action_report_wholesale_statement)d"
                            type="action" string="Generar PDF"
                            class="btn-primary" icon="fa-file-pdf-o"/>
                </header>
                <field name="partner_invoice_id" string="Cliente"/>
                <field name="name" string="Orden de venta"/>
                <field name="client_order_ref" string="Referencia del cliente"/>
                <field name="amount_total" string="Total de la orden"
                       optional="hide" sum="Total de órdenes"/>
                <field name="mkp_wholesale_customer_net" string="Monto neto"/>
                <field name="mkp_wholesale_paid" string="Monto pagado"/>
                <field name="mkp_wholesale_customer_amount_due" string="Monto adeudado"/>
                <field name="mkp_wholesale_payment_dates" string="Fechas de pago"/>
                <field name="mkp_wholesale_last_payment_date" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_wholesale_statement_search" model="ir.ui.view">
        <field name="name">sale.order.wholesale.statement.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Buscar estado de clientes Mayoreo">
                <field name="partner_invoice_id" string="Cliente"/>
                <field name="name" string="Orden de venta"/>
                <field name="client_order_ref"/>
                <field name="user_id"/>
                <filter name="group_customer" string="Cliente"
                        context="{'group_by':'partner_invoice_id'}"/>
                <filter name="group_salesperson" string="Vendedor"
                        context="{'group_by':'user_id'}"/>
                <filter name="group_order_month" string="Mes del pedido"
                        context="{'group_by':'date_order:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_wholesale_customer_statement" model="ir.actions.act_window">
        <field name="name">Estado de clientes Mayoreo</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_order_wholesale_statement_list"/>
        <field name="search_view_id" ref="view_sale_order_wholesale_statement_search"/>
        <field name="domain">[('mkp_collection_type','=','wholesale')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay pedidos de Mayoreo.</p>
        </field>
    </record>
</odoo>
